{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_multi_core",

  // 1-2 sentence summary about this repo.
  "summary": "Workspace model of the gg_multi tool family: ocean/tickets/trash layout, org folders, url parsing, git platforms, ticket metadata and state, publish planning.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "workspace layout: .ocean, tickets, .trash, org folders, RepoFolderResolver, migrations",
    "GitHub/Azure DevOps urls, fetchOrgRepos; ticket.json, TicketState, TicketLocalizer, cleanUpTicket",
    "publish planning: PublishPlanner asks all repos on one sheet, interactive flag; PublishSkipCheck",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_one_core": "GgState, GgSystemCommit in TicketLocalizer",
      "gg_one": "re-exported gg_one_core API: MessageSheet, RepoPublishConfig, PublishState, VersionSelector, terminal guard",
      "gg_local_package_dependencies": "dependency graph of the ticket repos",
      "gg_localize_refs": "localizes refs between ticket repos",
      "gg_publish": "version increments in PublishPlanner",
      "gg_git": "git state, branches, remotes",
      "gg_lang": "manifests, versions, publish targets",
      "gg_args": "command base",
      "gg_console_colors": "colored output",
      "gg_log": "GgLog",
      "dna_ggsuite": "dev: DNA layer: guides, templates",
      "helix": "dev: runDnaTest",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_multi_commit": "WorkspaceUtils, TicketState, TicketLocalizer; PublishPlanner for gg do review",
      "gg_multi_do_publish": "PublishPlanner, PublishSkipCheck, TicketState, cleanUpTicket",
      "gg_multi_workspace": "RepoFolderResolver, WorkspaceUtils, Organization, UrlParser, Trash, TicketJson",
      "gg_multi": "re-exports gg_multi_core",
    },
  },
}
